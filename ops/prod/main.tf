# Terraform Cloud Setup
terraform {
  cloud {
    organization = "vouch"
    workspaces {
      name = "vouch"
    }
  }
  required_providers {
    digitalocean = {
      source  = "digitalocean/digitalocean"
      version = "~> 2.0"
    }
    cloudflare = {
      source  = "cloudflare/cloudflare"
      version = "~> 5"
    }
  }
}
